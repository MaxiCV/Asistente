{
  "additionalProperties": false,
  "properties": {
    "provider": {
      "const": "google-genai",
      "default": "google-genai",
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "default": "gemini-3.5-flash-lite",
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "temperature": {
      "anyOf": [
        {
          "maximum": 2,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "max_output_tokens": {
      "default": 2048,
      "maximum": 8192,
      "minimum": 128,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "top_k": {
      "default": 5,
      "maximum": 10,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    },
    "max_history_turns": {
      "default": 4,
      "maximum": 20,
      "minimum": 0,
      "title": "Max History Turns",
      "type": "integer"
    },
    "max_prompt_chars": {
      "default": 40000,
      "maximum": 200000,
      "minimum": 2000,
      "title": "Max Prompt Chars",
      "type": "integer"
    },
    "timeout_seconds": {
      "default": 30,
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "operation_timeout_seconds": {
      "default": 60,
      "exclusiveMinimum": 0,
      "maximum": 65,
      "title": "Operation Timeout Seconds",
      "type": "number"
    },
    "default_mode": {
      "default": "hybrid",
      "enum": [
        "semantic",
        "lexical",
        "hybrid"
      ],
      "title": "Default Mode",
      "type": "string"
    }
  },
  "title": "ChatConfig",
  "type": "object"
}
