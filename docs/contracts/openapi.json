{
  "openapi": "3.1.0",
  "info": {
    "title": "Buscador de literatura sobre detección de caídas",
    "description": "Búsqueda semántica local con filtros y generación fijada. Calidad en Sprint 3.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Disponibilidad"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "tags": [
          "Disponibilidad"
        ],
        "summary": "Ready",
        "operationId": "ready_api_v1_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "No listo"
          }
        }
      }
    },
    "/api/v1/documents": {
      "get": {
        "tags": [
          "Corpus"
        ],
        "summary": "Search",
        "operationId": "search_api_v1_documents_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "title": "Q"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date From"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date To"
            }
          },
          {
            "name": "document_type",
            "in": "query",
            "required": false,
            "schema": {
              "const": "publication",
              "type": "string",
              "default": "publication",
              "title": "Document Type"
            }
          },
          {
            "name": "publication_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Publication Type"
            }
          },
          {
            "name": "index_generation",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Index Generation"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dependencia no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Generación retirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{document_id}": {
      "get": {
        "tags": [
          "Corpus"
        ],
        "summary": "Detail",
        "operationId": "detail_api_v1_documents__document_id__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          },
          {
            "name": "index_generation",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Index Generation"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dependencia no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Generación retirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/corpus": {
      "get": {
        "tags": [
          "Corpus"
        ],
        "summary": "Corpus",
        "operationId": "corpus_api_v1_corpus_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpusResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dependencia no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Generación retirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Author": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "orcid": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Orcid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Author"
      },
      "ChunkingConfig": {
        "properties": {
          "method": {
            "type": "string",
            "const": "token-window-v1",
            "title": "Method",
            "default": "token-window-v1"
          },
          "max_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Tokens",
            "default": 512
          },
          "overlap_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Overlap Tokens",
            "default": 32
          },
          "include_title": {
            "type": "boolean",
            "const": true,
            "title": "Include Title",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChunkingConfig"
      },
      "CorpusResponse": {
        "properties": {
          "index_generation": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index Generation"
          },
          "document_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Document Count"
          },
          "abstract_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Abstract Count"
          },
          "abstract_coverage": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Abstract Coverage"
          },
          "last_run": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunRecord"
              },
              {
                "type": "null"
              }
            ]
          },
          "manifest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GenerationManifest"
              },
              {
                "type": "null"
              }
            ]
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "publication_types": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Publication Types"
          },
          "maintenance_status_unavailable": {
            "type": "boolean",
            "title": "Maintenance Status Unavailable",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index_generation",
          "document_count",
          "abstract_count",
          "abstract_coverage"
        ],
        "title": "CorpusResponse"
      },
      "Document": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "document_type": {
            "type": "string",
            "const": "publication",
            "title": "Document Type",
            "default": "publication"
          },
          "publication_type": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Publication Type"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "authors": {
            "items": {
              "$ref": "#/components/schemas/Author"
            },
            "type": "array",
            "title": "Authors"
          },
          "publication_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publication Date"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "es",
                  "en"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doi"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Source Url"
          },
          "abstract": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstract"
          },
          "content_level": {
            "type": "string",
            "enum": [
              "metadata",
              "abstract"
            ],
            "title": "Content Level"
          },
          "identities": {
            "items": {
              "$ref": "#/components/schemas/SourceIdentity"
            },
            "type": "array",
            "minItems": 1,
            "title": "Identities"
          },
          "technology": {
            "$ref": "#/components/schemas/Technology",
            "default": "ND"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence",
            "default": "ND"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "title",
          "source_url",
          "content_level",
          "identities"
        ],
        "title": "Document"
      },
      "DocumentResponse": {
        "properties": {
          "index_generation": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Index Generation"
          },
          "document": {
            "$ref": "#/components/schemas/Document"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index_generation",
          "document"
        ],
        "title": "DocumentResponse"
      },
      "EmbeddingConfig": {
        "properties": {
          "model_id": {
            "type": "string",
            "const": "intfloat/multilingual-e5-small",
            "title": "Model Id"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "title": "Revision"
          },
          "dimensions": {
            "type": "integer",
            "const": 384,
            "title": "Dimensions",
            "default": 384
          },
          "max_tokens": {
            "type": "integer",
            "const": 512,
            "title": "Max Tokens",
            "default": 512
          },
          "query_prefix": {
            "type": "string",
            "const": "query: ",
            "title": "Query Prefix",
            "default": "query: "
          },
          "passage_prefix": {
            "type": "string",
            "const": "passage: ",
            "title": "Passage Prefix",
            "default": "passage: "
          },
          "normalize": {
            "type": "boolean",
            "const": true,
            "title": "Normalize",
            "default": true
          },
          "distance": {
            "type": "string",
            "const": "Cosine",
            "title": "Distance",
            "default": "Cosine"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_id",
          "revision"
        ],
        "title": "EmbeddingConfig"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "title": "Code"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "Evidence": {
        "type": "string",
        "enum": [
          "laboratorio",
          "simulada",
          "real_hogar",
          "mixta",
          "ND"
        ],
        "title": "Evidence"
      },
      "GenerationManifest": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "generation_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Generation Id"
          },
          "status": {
            "type": "string",
            "const": "validated",
            "title": "Status",
            "default": "validated"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "documents_collection": {
            "type": "string",
            "minLength": 1,
            "title": "Documents Collection"
          },
          "passages_collection": {
            "type": "string",
            "minLength": 1,
            "title": "Passages Collection"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Snapshot Id"
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Snapshot Sha256"
          },
          "review_csv_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Review Csv Sha256"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Config Sha256"
          },
          "embedding": {
            "$ref": "#/components/schemas/EmbeddingConfig"
          },
          "chunking": {
            "$ref": "#/components/schemas/ChunkingConfig"
          },
          "document_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Document Count"
          },
          "passage_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Passage Count"
          },
          "abstract_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Abstract Count"
          },
          "excluded_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Excluded Count"
          },
          "pending_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Pending Count"
          },
          "publication_types": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Publication Types"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "generation_id",
          "created_at",
          "documents_collection",
          "passages_collection",
          "snapshot_id",
          "snapshot_sha256",
          "review_csv_sha256",
          "config_sha256",
          "embedding",
          "chunking",
          "document_count",
          "passage_count",
          "abstract_count",
          "excluded_count",
          "pending_count"
        ],
        "title": "GenerationManifest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunRecord": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "run_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Run Id"
          },
          "operation": {
            "type": "string",
            "enum": [
              "fetch",
              "build",
              "publish",
              "rollback"
            ],
            "title": "Operation"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          },
          "generation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation Id"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "operation",
          "status",
          "started_at"
        ],
        "title": "RunRecord"
      },
      "SearchHit": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document",
          "score"
        ],
        "title": "SearchHit"
      },
      "SearchResponse": {
        "properties": {
          "index_generation": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Index Generation"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "type": "array",
            "title": "Results"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Page Size"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          },
          "filtered_document_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Filtered Document Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index_generation",
          "results",
          "page",
          "page_size",
          "has_more",
          "filtered_document_count"
        ],
        "title": "SearchResponse"
      },
      "SourceIdentity": {
        "properties": {
          "openalex_id": {
            "type": "string",
            "pattern": "^https://openalex.org/W[0-9]+$",
            "title": "Openalex Id"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Snapshot Id"
          },
