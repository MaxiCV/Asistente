{
  "$defs": {
    "FetchConfig": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "from_date": {
          "default": "2020-01-01",
          "format": "date",
          "title": "From Date",
          "type": "string"
        },
        "languages": {
          "items": {
            "enum": [
              "es",
              "en"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "searches": {
          "items": {
            "$ref": "#/$defs/FetchSearch"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Searches",
          "type": "array"
        },
        "per_page": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Per Page",
          "type": "integer"
        },
        "max_requests": {
          "default": 40,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_retries": {
          "default": 3,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "request_interval_seconds": {
          "default": 0.3,
          "maximum": 30,
          "minimum": 0,
          "title": "Request Interval Seconds",
          "type": "number"
        },
        "max_retry_wait_seconds": {
          "default": 30,
          "maximum": 60,
          "minimum": 1,
          "title": "Max Retry Wait Seconds",
          "type": "number"
        }
      },
      "required": [
        "searches"
      ],
      "title": "FetchConfig",
      "type": "object"
    },
    "FetchSearch": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "has_abstract": {
          "title": "Has Abstract",
          "type": "boolean"
        },
        "max_records": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Records",
          "type": "integer"
        }
      },
      "required": [
        "query",
        "has_abstract",
        "max_records"
      ],
      "title": "FetchSearch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source": {
      "const": "openalex",
      "default": "openalex",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "Status",
      "type": "string"
    },
    "searches": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Searches",
      "type": "array"
    },
    "from_date": {
      "format": "date",
      "title": "From Date",
      "type": "string"
    },
    "cutoff_date": {
      "format": "date",
      "title": "Cutoff Date",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "record_count": {
      "minimum": 0,
      "title": "Record Count",
      "type": "integer"
    },
    "works_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Works Sha256"
    },
    "errors": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "fetch_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/FetchConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_count": {
      "default": 0,
      "minimum": 0,
      "title": "Request Count",
      "type": "integer"
    },
    "duplicate_observations": {
      "default": 0,
      "minimum": 0,
      "title": "Duplicate Observations",
      "type": "integer"
    },
    "quarantined_count": {
      "default": 0,
      "minimum": 0,
      "title": "Quarantined Count",
      "type": "integer"
    },
    "requests_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requests Sha256"
    },
    "quarantine_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quarantine Sha256"
    }
  },
  "required": [
    "snapshot_id",
    "status",
    "searches",
    "from_date",
    "cutoff_date",
    "started_at",
    "record_count"
  ],
  "title": "SnapshotManifest",
  "type": "object"
}
