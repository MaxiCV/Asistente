{
  "$defs": {
    "ChunkingConfig": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "token-window-v1",
          "default": "token-window-v1",
          "title": "Method",
          "type": "string"
        },
        "max_tokens": {
          "default": 512,
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "overlap_tokens": {
          "default": 32,
          "minimum": 0,
          "title": "Overlap Tokens",
          "type": "integer"
        },
        "include_title": {
          "const": true,
          "default": true,
          "title": "Include Title",
          "type": "boolean"
        }
      },
      "title": "ChunkingConfig",
      "type": "object"
    },
    "EmbeddingConfig": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "const": "intfloat/multilingual-e5-small",
          "title": "Model Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "dimensions": {
          "const": 384,
          "default": 384,
          "title": "Dimensions",
          "type": "integer"
        },
        "max_tokens": {
          "const": 512,
          "default": 512,
          "title": "Max Tokens",
          "type": "integer"
        },
        "query_prefix": {
          "const": "query: ",
          "default": "query: ",
          "title": "Query Prefix",
          "type": "string"
        },
        "passage_prefix": {
          "const": "passage: ",
          "default": "passage: ",
          "title": "Passage Prefix",
          "type": "string"
        },
        "normalize": {
          "const": true,
          "default": true,
          "title": "Normalize",
          "type": "boolean"
        },
        "distance": {
          "const": "Cosine",
          "default": "Cosine",
          "title": "Distance",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "revision"
      ],
      "title": "EmbeddingConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "generation_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Generation Id",
      "type": "string"
    },
    "status": {
      "const": "validated",
      "default": "validated",
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "documents_collection": {
      "minLength": 1,
      "title": "Documents Collection",
      "type": "string"
    },
    "passages_collection": {
      "minLength": 1,
      "title": "Passages Collection",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "review_csv_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Csv Sha256",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "embedding": {
      "$ref": "#/$defs/EmbeddingConfig"
    },
    "chunking": {
      "$ref": "#/$defs/ChunkingConfig"
    },
    "document_count": {
      "minimum": 0,
      "title": "Document Count",
      "type": "integer"
    },
    "passage_count": {
      "minimum": 0,
      "title": "Passage Count",
      "type": "integer"
    },
    "abstract_count": {
      "minimum": 0,
      "title": "Abstract Count",
      "type": "integer"
    },
    "excluded_count": {
      "minimum": 0,
      "title": "Excluded Count",
      "type": "integer"
    },
    "pending_count": {
      "minimum": 0,
      "title": "Pending Count",
      "type": "integer"
    },
    "publication_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Publication Types",
      "type": "array"
    }
  },
  "required": [
    "generation_id",
    "created_at",
    "documents_collection",
    "passages_collection",
    "snapshot_id",
    "snapshot_sha256",
    "review_csv_sha256",
    "config_sha256",
    "embedding",
    "chunking",
    "document_count",
    "passage_count",
    "abstract_count",
    "excluded_count",
    "pending_count"
  ],
  "title": "GenerationManifest",
  "type": "object"
}
