{
  "additionalProperties": false,
  "properties": {
    "mode": {
      "default": "semantic",
      "enum": [
        "semantic",
        "lexical",
        "hybrid"
      ],
      "title": "Mode",
      "type": "string"
    },
    "q": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Q",
      "type": "string"
    },
    "date_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date From"
    },
    "date_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date To"
    },
    "document_type": {
      "default": "publication",
      "enum": [
