        "patent",
        "all"
      ],
      "title": "Document Type",
      "type": "string"
    },
    "publication_type": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Type"
    },
    "index_generation": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
