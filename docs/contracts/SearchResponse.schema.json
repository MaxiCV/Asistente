{
  "$defs": {
    "Author": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "orcid": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orcid"
        }
      },
      "required": [
        "name"
      ],
      "title": "Author",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_type": {
          "const": "publication",
          "default": "publication",
          "title": "Document Type",
          "type": "string"
        },
        "publication_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Type"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "authors": {
          "items": {
            "$ref": "#/$defs/Author"
          },
          "title": "Authors",
          "type": "array"
        },
        "publication_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Date"
        },
        "language": {
          "anyOf": [
            {
              "enum": [
                "es",
                "en"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "abstract": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstract"
        },
        "content_level": {
          "enum": [
            "metadata",
            "abstract"
          ],
          "title": "Content Level",
          "type": "string"
        },
        "identities": {
          "items": {
            "$ref": "#/$defs/SourceIdentity"
          },
          "minItems": 1,
          "title": "Identities",
          "type": "array"
        },
        "technology": {
          "$ref": "#/$defs/Technology",
          "default": "ND"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence",
          "default": "ND"
        }
      },
      "required": [
        "document_id",
        "title",
        "source_url",
        "content_level",
        "identities"
      ],
      "title": "Document",
      "type": "object"
    },
    "Evidence": {
      "enum": [
        "laboratorio",
        "simulada",
        "real_hogar",
        "mixta",
        "ND"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "SearchHit": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/Document"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "document",
        "score"
      ],
      "title": "SearchHit",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "openalex_id": {
          "pattern": "^https://openalex.org/W[0-9]+$",
          "title": "Openalex Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        }
      },
      "required": [
        "openalex_id",
        "snapshot_id",
        "retrieved_at"
      ],
      "title": "SourceIdentity",
      "type": "object"
    },
    "Technology": {
      "enum": [
        "camara",
        "vestible",
        "ambiente",
        "mixta",
        "ND"
      ],
      "title": "Technology",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "index_generation": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Index Generation",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/SearchHit"
      },
      "title": "Results",
      "type": "array"
    },
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "page_size": {
      "maximum": 100,
      "minimum": 1,
      "title": "Page Size",
      "type": "integer"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "filtered_document_count": {
      "minimum": 0,
      "title": "Filtered Document Count",
      "type": "integer"
    }
  },
  "required": [
    "index_generation",
    "results",
    "page",
    "page_size",
    "has_more",
    "filtered_document_count"
  ],
  "title": "SearchResponse",
  "type": "object"
}
