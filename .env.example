# Copiar a .env. Solo la CLI de comprobación/ingesta utiliza esta credencial.
OPENALEX_API_KEY=
# Chat: GEMINI_API_KEY tiene precedencia sobre el alias GOOGLE_API_KEY.
# Solo se utiliza al generar respuestas; búsqueda y corpus funcionan sin esta clave.
GEMINI_API_KEY=
# EPO Developer Portal: credenciales de aplicación OPS, solo para la CLI.
# También se admiten EPO_CONSUMER_KEY y EPO_CONSUMER_SECRET.
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
QDRANT_URL=http://127.0.0.1:6333
ASISTENTE_DATA_DIR=./data
EMBEDDING_DEVICE=cpu
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
